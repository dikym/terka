@startuml Terka_ERD

' ============================================================
' TERKA — Entity Relationship Diagram (ERD)
' Acuan: Terka PRD, SRD, TRD
'
' Konvensi:
'   - Nama tabel, nama kolom, dan seluruh nilai enum memakai bahasa
'     Inggris. Singkatan hanya dipakai untuk satuan (_ms) dan tiga nama
'     pendek yang dipakai konsisten: client_ts, tz, fsrs.
'   - Semua waktu memakai timestamptz. Tanggal murni memakai date.
'     Semua teks memakai text.
'   - Enum disimpan sebagai text dengan CHECK, bukan tipe enum bawaan
'     Postgres, agar nilai baru bisa ditambahkan tanpa mengunci tabel.
'     Enum dan format yang dipakai beberapa kolom memakai domain:
'     uuid_v7, scope_level, card_mode, content_ref.
'   - Tabel event tidak memiliki kolom generated. card_id
'     (content_id::mode) dibentuk klien dan tidak disimpan di database.
'   - Domain card_mode berisi lima nilai: code2region, region2code,
'     setrecall, special2holder, holder2special. Tebak berwaktu adalah
'     soal Level 3 (question_type = typed), bukan mode kartu.
'   - Kolom review_logs ditulis menurut alignment: uuid, 8 byte,
'     4 byte, 2 byte, boolean, lalu kolom panjang variabel.
'   - server_seq tidak diberi unique constraint; sequence sudah
'     menjamin keunikannya.
'   - Tabel event ber-ID memakai kunci utama gabungan
'     (user_id, id), dan setiap foreign key antartabel pengguna ikut
'     membawa user_id. Baris satu pengguna tidak bisa menunjuk baris
'     pengguna lain, bahkan dengan id yang ditebak.
'   - Entitas bertanda <<bundle>> bukan tabel database. Isinya ada di
'     plates.json yang dikunci saat build. Garis putus-putus adalah
'     rujukan lunak lewat id teks, divalidasi saat build dan replay.
'   - Penjelasan tiap kolom, daftar nilai enum, dan alasan desain ada
'     di Terka_ERD.md.
'   - Diagram ini digambar tangan sampai migration pertama ada. Setelah
'     itu diagram dihasilkan dari database, dan SQL migration menjadi
'     acuan skema fisik (Terka_ERD.md, bagian pembuka).
'
' Prinsip desain:
'   1. Riwayat menjadi acuan; keadaan aplikasi dihitung dari riwayat.
'   2. Server menyimpan dan menjaga, tidak menghitung.
'   3. Pengguna tanpa akun tidak memiliki satu baris pun.
'   4. Kepemilikan dijaga struktur, bukan hanya policy.
'   5. Perubahan skema dilakukan bertahap sesuai TRD 7.
' ============================================================

skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Liberation Sans"
skinparam nodesep 40
skinparam ranksep 70
skinparam ArrowThickness 0.8
hide circle
hide stereotype

' ============================================================
' IDENTITAS, PERANGKAT, PERSETUJUAN
' ============================================================

entity "auth.users" as auth_users {
  * id : uuid <<PK>>
  --
  email : text
  raw_user_meta_data : jsonb
  * created_at : timestamptz
  --
  dikelola Supabase Auth
}

entity devices {
  * user_id : uuid <<PK>> <<FK>>
  * id : uuid <<PK>>
  --
  * label : text
  * platform : text
  * created_at : timestamptz
  * last_seen_at : timestamptz = now()
  --
  maks. 20 perangkat aktif (90 hari)
}

entity user_settings {
  * user_id : uuid <<PK>> <<FK>>
  --
  * active_scope_level : scope_level = 'national'
  active_scope_id : text
  * special_enabled : boolean = false
  * updated_at : timestamptz
  * updated_by_device : uuid <<FK>>
  * received_at : timestamptz = now()
}

entity privacy_policy_versions {
  * version : text <<PK>>
  --
  * published_at : timestamptz
  * requires_reconsent : boolean = true
  * summary_url : text
}

entity timezones {
  * name : text <<PK>>
  --
  diisi migration dari pg_timezone_names
}

entity privacy_consents {
  * user_id : uuid <<PK>> <<FK>>
  * policy_version : text <<PK>> <<FK>>
  --
  * device_id : uuid <<FK>>
  * consented_at : timestamptz
  * received_at : timestamptz = now()
}

' ============================================================
' LOG LATIHAN
' ============================================================

entity practice_runs {
  * user_id : uuid <<PK>> <<FK>>
  * id : uuid <<PK>>
  --
  * device_id : uuid <<FK>>
  * kind : text
  * scope_level : scope_level
  scope_id : text
  * started_at : timestamptz
  * local_day : date
  planned_count : integer
  estimated_ms : integer
  ended_at : timestamptz
  answered : integer
  correct : integer
  score : integer
  placement_level : text
  active_ms : integer
  * received_at : timestamptz = now()
  * server_seq : bigint
  --
  server_seq diganti saat sesi ditutup
}

entity review_logs {
  * user_id : uuid <<PK>> <<FK>>
  * id : uuid <<PK>>
  --
  ' urutan kolom mengikuti alignment (ERD bagian konvensi tipe data)
  * device_id : uuid <<FK>>
  run_id : uuid <<FK>>
  * client_ts : timestamptz
  * received_at : timestamptz = now()
  * server_seq : bigint
  * ms_total : integer
  ms_to_first_key : integer
  ms_typing : integer
  * local_day : date
  * level : smallint
  * deleted_chars : smallint = 0
  * option_changes : smallint = 0
  option_count : smallint
  * answer_rules_version : smallint
  * content_version : smallint
  * engine_version : smallint
  set_correct : smallint
  set_threshold : smallint
  correct : boolean
  * timed_out : boolean = false
  * unknown : boolean = false
  * interrupted : boolean = false
  * typo_cost : numeric(3,1) = 0
  * content_id : content_ref
  * mode : card_mode
  * context : text
  * level_source : text = 'auto'
  * match_type : text = 'none'
  * question_type : text
  * input_mode : text
  * tz : text <<FK>>
  raw_answer : text
  accepted_area_id : text
  prompt_area_id : text
  confused_with : text
  drill_pair_with : text
  key_gaps_ms : smallint[]
  set_items : jsonb
}

entity review_voids {
  * user_id : uuid <<PK>> <<FK>>
  * id : uuid <<PK>>
  --
  * device_id : uuid <<FK>>
  * review_id : uuid <<FK>>
  * client_ts : timestamptz
  * received_at : timestamptz = now()
  * server_seq : bigint
  --
  <<UK>> (user_id, review_id)
}

entity card_events {
  * user_id : uuid <<PK>> <<FK>>
  * id : uuid <<PK>>
  --
  * device_id : uuid <<FK>>
  * content_id : content_ref
  * mode : card_mode
  * kind : text
  * client_ts : timestamptz
  * local_day : date
  * received_at : timestamptz = now()
  * server_seq : bigint
}

entity sightings {
  * user_id : uuid <<PK>> <<FK>>
  * id : uuid <<PK>>
  --
  * device_id : uuid <<FK>>
  * region_id : content_ref
  * client_ts : timestamptz
  * local_day : date
  * received_at : timestamptz = now()
  * server_seq : bigint
}

entity fact_views {
  * user_id : uuid <<PK>> <<FK>>
  * id : uuid <<PK>>
  --
  * device_id : uuid <<FK>>
  run_id : uuid <<FK>>
  * fact_id : text
  * client_ts : timestamptz
  * local_day : date
  * received_at : timestamptz = now()
  * server_seq : bigint
}

' ============================================================
' DATA PRIBADI LAIN
' ============================================================

entity card_notes {
  * user_id : uuid <<PK>> <<FK>>
  * content_id : content_ref <<PK>>
  --
  * body : text = ''
  * updated_at : timestamptz
  * updated_by_device : uuid <<FK>>
  * received_at : timestamptz = now()
}

entity fsrs_params {
  * user_id : uuid <<PK>> <<FK>>
  * id : uuid <<PK>>
  --
  * device_id : uuid <<FK>>
  * algorithm : text = 'fsrs-6'
  * library_version : text
  * weights : float8[]
  * status : text
  activated_at : timestamptz
  * trained_review_count : integer
  trained_through_seq : bigint
  * training_set_hash : bytea
  * logloss : float8
  * rmse : float8
  * baseline_logloss : float8
  * baseline_rmse : float8
  * created_at : timestamptz
  * received_at : timestamptz = now()
  * server_seq : bigint
}

' ============================================================
' PENGAMAN PEMAKAIAN
' ============================================================

entity usage_daily {
  * user_id : uuid <<PK>> <<FK>>
  * received_day : date <<PK>>
  * table_name : text <<PK>>
  --
  * row_count : integer = 0
}

entity service_flags {
  * id : smallint <<PK>> = 1
  --
  * signups_open : boolean = true
  * updated_at : timestamptz
}

entity usage_totals {
  * user_id : uuid <<PK>> <<FK>>
  --
  * row_count : integer = 0
}

' ============================================================
' KONTEN BUNDLE — plates.json, BUKAN TABEL DATABASE
' ============================================================

entity content_regions <<bundle>> {
  * id : text <<PK>>
  --
  * code : text
  * region : text
  * group : text
  * province : text
  * spans : text[]
  * placement_tier : text
  * confidence : text
  * aliases : text[]
}

entity content_areas <<bundle>> {
  * id : text <<PK>>
  --
  * type : text
  * name : text
  * province : text
  * aliases : text[]
  * variants : text[]
}

entity content_region_areas <<bundle>> {
  * region_id : text <<PK>> <<FK>>
  * area_id : text <<PK>> <<FK>>
  --
  * confidence : text
}

entity content_facts <<bundle>> {
  * id : text <<PK>>
  --
  * history_label : text
  * text : text
  * publication_status : text = 'draft'
  source : text
  source_checked_at : date
}

entity content_region_facts <<bundle>> {
  * region_id : text <<PK>> <<FK>>
  * fact_id : text <<PK>> <<FK>>
}

entity content_specials <<bundle>> {
  * id : text <<PK>>
  --
  * series : text
  * number : text
  * holder : text
  * holder_type : text
  * aliases : text[]
  * source_name : text
  * confidence : text
  * needs_review : boolean = false
  valid_from : date
  review_by : date
}

entity content_sources <<bundle>> {
  * id : text <<PK>>
  --
  * title : text
  * type : text
  date : date
  * url : text
  original_url : text
  * locator : text
  * checked_at : date
}

entity content_reference_plates <<bundle>> {
  * id : text <<PK>>
  --
  * series : text
  number : text
  * label : text
  * confidence : text
  note : text
  review_by : date
}

entity content_special_sources <<bundle>> {
  * special_id : text <<PK>> <<FK>>
  * source_id : text <<PK>> <<FK>>
}

' ============================================================
' RELASI
' ============================================================
' Setiap pasangan tabel digambarkan dengan satu relasi.
' Relasi device_id dan updated_by_device dijelaskan dalam kamus data;
' hanya hubungan perangkat dengan review_logs yang digambar.
' Garis tegas menunjukkan kunci asing. Garis putus-putus menunjukkan
' rujukan ID teks ke konten plates.json.
' Label relasi ditulis dalam bahasa Inggris, dibaca dari tabel kiri
' ke tabel kanan. Jumlah tanda hubung (--, ---, -----) hanya mengatur
' jarak baris di diagram, bukan makna relasi.

' --- Identitas dan persetujuan
auth_users              ||--o{ devices                  : "owns"
auth_users              ||--o| user_settings            : "configures"
auth_users              ||--o{ privacy_consents         : "gives"
privacy_policy_versions ||--o{ privacy_consents         : "is accepted through"
service_flags           ..  devices                     : "is checked on registration of"

' --- Log latihan
auth_users              ||--o{ practice_runs            : "runs"
auth_users              ||---o{ review_logs             : "answers"
auth_users              ||---o{ review_voids            : "undoes answers through"
auth_users              ||---o{ card_events             : "manages cards through"
auth_users              ||---o{ sightings               : "searches codes through"
auth_users              ||---o{ fact_views              : "reads"
devices                 ||--o{ review_logs              : "records"
practice_runs           |o--o{ review_logs              : "contains"
practice_runs           |o--o{ fact_views               : "closes with"
review_logs             ||--o| review_voids             : "is undone by"
timezones               ||--o{ review_logs              : "sets time zone of"

' --- Data pribadi lain
auth_users              ||---o{ card_notes              : "writes"
auth_users              ||---o{ fsrs_params             : "trains"

' --- Pengaman pemakaian
auth_users              ||-----o{ usage_daily           : "is metered daily in"
auth_users              ||-----o| usage_totals          : "is capped by"

' --- Konten bundle
content_regions         ||..o{ content_region_areas     : "is used through"
content_areas           ||..|{ content_region_areas     : "is linked through"
content_regions         ||..o{ content_region_facts     : "references facts through"
content_facts           ||..o{ content_region_facts     : "is referenced through"
content_specials        ||..|{ content_special_sources  : "is supported by"
content_sources         ||..o{ content_special_sources  : "supports"

' --- Log ke konten bundle
' Arah ditulis dari log ke konten supaya kelompok konten tersusun
' di bawah log, seperti tabel acuan di ujung rantai.
review_logs             }o..|| content_regions          : "asks about"
sightings               }o..|| content_regions          : "looks up"
card_notes              }o..|| content_regions          : "annotates"
card_events             }o..|| content_regions          : "acts on"
fact_views              }o..|| content_facts            : "shows"
review_logs             }o..|| content_specials         : "asks about"
card_notes              }o..|| content_specials         : "annotates"
card_events             }o..|| content_specials         : "acts on"

@enduml
