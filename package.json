		"react-dom": "19.2.4",
		"tailwindcss": "^4",
		"ts-fsrs": "5.4.2",
		"zod": "^3",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@types/bun": "^1.4.2",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"eslint": "^9",
		"eslint-config-next": "16.2.9",
		"fake-indexeddb": "^6.2.5",
