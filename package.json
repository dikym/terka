{
	"name": "terka",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "bun run content:check && next build",
		"build:logic": "bun run content:build && bun run check && bun build src/lib/terka/index.ts --target browser --outdir build/logic",
		"content:build": "bun scripts/build-content.ts",
		"content:check": "bun scripts/build-content.ts --release",
		"test": "bun test tests",
		"start": "next start",
		"lint": "eslint",
		"lint:fix": "eslint --fix",
		"format": "prettier --write .",
		"check": "tsc --noEmit"
	},
	"dependencies": {
		"@base-ui/react": "^1.6.0",
		"@supabase/ssr": "^0.12.0",
		"@supabase/supabase-js": "^2.108.2",
		"@tailwindcss/postcss": "^4",
		"@vercel/speed-insights": "^2.0.0",
		"browser-image-compression": "^2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"dexie": "^4.4.6",
		"lucide-react": "^1.21.0",
		"next": "16.2.9",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"resend": "^4",
		"shadcn": "^4.12.0",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4",
		"ts-fsrs": "^5.4.2",
		"tw-animate-css": "^1.4.0",
		"zod": "^3",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@types/bun": "^1.4.2",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"eslint": "^9",
		"eslint-config-next": "16.2.9",
		"fake-indexeddb": "^6.2.5",
		"prettier": "^3.9.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"supabase": "^2",
		"typescript": "^5"
	},
	"ignoreScripts": [
		"sharp",
		"unrs-resolver"
	],
	"trustedDependencies": [
		"sharp",
		"unrs-resolver"
	],
	"browserslist": [
		"chrome >= 111",
		"edge >= 111",
		"firefox >= 111",
		"safari >= 16.4"
	]
}
